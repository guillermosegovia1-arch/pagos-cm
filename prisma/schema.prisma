datasource db {
  provider = "postgresql"
  url      = "postgresql://neondb_owner:npg_MY1RQZa0bIJB@ep-rapid-unit-b4bdxgsg-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require"
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

model User {
  id            String   @id @default(uuid())
  nombre        String
  usuario       String   @unique
  password      String
  passwordPlain String
  role          String   @default("ALUMNO")
  nivelEscolar  String
  grado         String?
  grupo         String?
  estado        String   @default("Alta")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pagos         Pago[]
}

model Pago {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  concepto           String
  tipo               String    @default("ANUAL")
  estado             String    @default("Pendiente")
  numeroConfirmacion String?
  motivoAclaracion   String?
  comentarioAdmin    String?
  respuestaAlumno    String?
  notaConcepto       String?
  mesColegiatura     String?
  fechaVencimiento   DateTime?
  fechaReportado     DateTime?
  fechaConfirmado    DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
